---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_URL } from '../data/site-config';
import { route } from '../i18n/routes';
import { breadcrumbSchema } from '../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/watering-calculator/" title="Houseplant watering calculator" width="100%" height="760" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Houseplant Watering Calculator on Your Site" description="Add the PlantCare101 houseplant watering calculator to your website for free with one iframe: no sign-up, no tracking, calculated in the visitor's browser, kept up to date." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6"><h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the watering calculator on your site</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code, no sign-up, no fee. Plant shops, garden clubs, extension volunteers and plant blogs can offer the calculator to their readers in a minute.</p></header>
  <div class="prose prose-slate max-w-none">
    <p>Paste this code where the calculator should appear. The height does not adjust automatically: 760 pixels suit a wide column; allow about 1,200 pixels in a narrow one.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: the link to plantcare101.com shown under the calculator must stay visible, and the widget must not be altered. It is provided without guarantee of availability or result. Plants and rules are updated on this site, so your embed stays current without any action on your side.</p>
    <p>No data from your visitors reaches us: the calculation runs in their browser and the iframe sets no tracking or advertising cookie. For another size or a question, use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/watering-calculator/" title="Houseplant watering calculator" width="100%" height="760" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
