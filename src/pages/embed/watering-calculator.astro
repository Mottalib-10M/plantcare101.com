---
/** Page embarquable (iframe) : calculateur nu, lien de crédit visible (RECETTE §13). */
import '../../styles/global.css';
import WateringCalc from '../../components/calc/WateringCalc';
import { SITE_URL } from '../../data/site-config';
import { plantOptions } from '../../lib/plants';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Houseplant watering calculator, widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/tools/watering-calculator/`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <WateringCalc client:load plants={plantOptions()} defaultSlug="snake-plant" methodHref={`${SITE_URL}/methodology/`} idPrefix="we" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/tools/watering-calculator/`} target="_blank" rel="noopener" class="hover:underline">plantcare101.com</a> · watering calculator, computed in your browser</p>
  </body>
</html>
